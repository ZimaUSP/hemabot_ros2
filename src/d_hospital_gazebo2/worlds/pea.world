<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pea">

    <!--
      Ambiente fechado e quadrado para Gazebo Classic.

      Dimensões principais:
      - Área interna aproximada: 22 m x 22 m
      - Corredor central: 22 m de comprimento x 1.75 m de largura
      - 4 salas: duas acima e duas abaixo do corredor
      - Portas: 1.20 m de largura, uma porta por sala
      - Altura das paredes: 2.80 m
      - Espessura das paredes: 0.20 m

      Sistema de coordenadas:
      - O corredor fica ao longo do eixo X, de x = -11 até x = +11
      - A largura do corredor vai de y = -0.875 até y = +0.875
    -->

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.78 0.82 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Piso -->
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>22.4 22.4 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>22.4 22.4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.01 0 0 0</pose>
    </model>

    <!-- ===== Paredes externas: ambiente quadrado fechado ===== -->

    <model name="wall_outer_north">
      <static>true</static>
      <pose>0 11.1 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>22.4 0.2 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>22.4 0.2 2.8</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_outer_south">
      <static>true</static>
      <pose>0 -11.1 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>22.4 0.2 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>22.4 0.2 2.8</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_outer_east">
      <static>true</static>
      <pose>11.1 0 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 22.4 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 22.4 2.8</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_outer_west">
      <static>true</static>
      <pose>-11.1 0 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 22.4 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 22.4 2.8</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== Paredes do corredor central com aberturas para portas ===== -->
    <!-- Corredor: comprimento 22 m, largura 1.75 m -->

    <!-- Parede superior do corredor: segmentos com portas em x=-5.5 e x=+5.5 -->
    <model name="corridor_top_left_segment">
      <static>true</static>
      <pose>-8.55 0.975 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.9 0.2 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.9 0.2 2.8</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="corridor_top_center_segment">
      <static>true</static>
      <pose>0 0.975 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.8 0.2 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.8 0.2 2.8</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="corridor_top_right_segment">
      <static>true</static>
      <pose>8.55 0.975 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.9 0.2 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.9 0.2 2.8</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Parede inferior do corredor: segmentos com portas em x=-5.5 e x=+5.5 -->
    <model name="corridor_bottom_left_segment">
      <static>true</static>
      <pose>-8.55 -0.975 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.9 0.2 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.9 0.2 2.8</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="corridor_bottom_center_segment">
      <static>true</static>
      <pose>0 -0.975 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>9.8 0.2 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>9.8 0.2 2.8</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="corridor_bottom_right_segment">
      <static>true</static>
      <pose>8.55 -0.975 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.9 0.2 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.9 0.2 2.8</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===== Paredes internas que separam as 4 salas ===== -->

    <!-- Divisão entre as duas salas superiores -->
    <model name="wall_room_divider_north">
      <static>true</static>
      <pose>0 6.0375 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 9.925 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 9.925 2.8</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Divisão entre as duas salas inferiores -->
    <model name="wall_room_divider_south">
      <static>true</static>
      <pose>0 -6.0375 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 9.925 2.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 9.925 2.8</size></box></geometry><material><ambient>0.80 0.80 0.78 1</ambient><diffuse>0.80 0.80 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Marcadores visuais discretos das portas, sem colisão -->
    <model name="door_marker_room_1">
      <static>true</static>
      <pose>-5.5 0.98 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 0.04 0.02</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="door_marker_room_2">
      <static>true</static>
      <pose>5.5 0.98 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 0.04 0.02</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="door_marker_room_3">
      <static>true</static>
      <pose>-5.5 -0.98 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 0.04 0.02</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="door_marker_room_4">
      <static>true</static>
      <pose>5.5 -0.98 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 0.04 0.02</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
