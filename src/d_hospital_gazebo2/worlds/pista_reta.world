<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pista_corrida_1_7m">

    <!-- Luz -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Chão -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Física -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- Parede inferior -->
    <model name="wall_bottom">
      <static>true</static>
      <link name="link">
        <pose>0 -0.85 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.2 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Parede superior -->
    <model name="wall_top">
      <static>true</static>
      <link name="link">
        <pose>0 0.85 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>20 0.2 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20 0.2 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Parede esquerda -->
    <model name="wall_left">
      <static>true</static>
      <link name="link">
        <pose>-10 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 1.7 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 1.7 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Parede direita -->
    <model name="wall_right">
      <static>true</static>
      <link name="link">
        <pose>10 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 1.7 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 1.7 1</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>