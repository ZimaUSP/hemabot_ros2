<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  
  <!-- Real robot ros2_control -->
  <xacro:unless value="$(arg sim_mode)">
    <ros2_control name='RealRobot' type='system'>
      <hardware>
        <plugin>firmware_minihema/MinihemaHardware</plugin>
          <param name='left_wheel_name'>left_wheel_joint</param>
          <param name='right_wheel_name'>right_wheel_joint</param>
	  <param name='enc_ticks_per_rev'>12</param>
	  <!-- Wheel speed estimation from the interval between encoder pulses -->
	  <param name='velocity_timeout'>0.5</param>
	  <param name='velocity_filter_alpha'>0.5</param>
	  <!-- Feedforward per motor: duty = static_duty + duty_per_rad_s * |speed| (duty in 0..1).
	       static_duty is the dead zone; the right motor needs ~18% more duty than the left one.
	       See firmware_minihema/README.md for how to calibrate these values. -->
	  <param name='left_static_duty'>0.26</param>
	  <param name='left_duty_per_rad_s'>0.0883</param>
	  <param name='right_static_duty'>0.26</param>
	  <param name='right_duty_per_rad_s'>0.1042</param>
	  <!-- PI feedback on wheel speed (duty per rad/s, duty per rad) -->
	  <param name='speed_kp'>0.06</param>
	  <param name='speed_ki'>0.15</param>
	  <param name='speed_integral_limit'>0.25</param>
	  <param name='max_duty'>1.0</param>
	  <param name='spin_up_time'>0.2</param>
	  <!-- Warn when two control cycles are further apart than this (s) -->
	  <param name='loop_stall_warn_period'>0.15</param>
      </hardware>
      <joint name='left_wheel_joint'>
        <command_interface name='velocity'>
          <param name='min'>-20</param>
          <param name='max'>20</param>
        </command_interface>
        <state_interface name='velocity'/>
        <state_interface name='position'/>
      </joint>
      <joint name='right_wheel_joint'>
        <command_interface name='velocity'>
          <param name='min'>-20</param>
          <param name='max'>20</param>
        </command_interface>
        <state_interface name='velocity'/>
        <state_interface name='position'/>
      </joint>
    </ros2_control>

    <!-- MPU6050 sensor--> 
    <ros2_control name='MPU6050' type='sensor'>
      <hardware>
        <plugin>minihema_launch/MPU6050Hardware</plugin>
          <param name='sensor_name'>mpu6050</param>
          <param name='frame_id'>imu_link</param>
      </hardware>
      <sensor name='mpu6050'>
        <state_interface name='orientation.x'/>
        <state_interface name='orientation.y'/>
        <state_interface name='orientation.z'/>
        <state_interface name='orientation.w'/>
        <state_interface name='angular_velocity.x'/>
        <state_interface name='angular_velocity.y'/>
        <state_interface name='angular_velocity.z'/>
        <state_interface name='linear_acceleration.x'/>
        <state_interface name='linear_acceleration.y'/>
        <state_interface name='linear_acceleration.z'/>  
      </sensor>
    </ros2_control>
  </xacro:unless>
  
  <!-- Gazebo ros2_control -->
  <xacro:if value="$(arg sim_mode)">
    <ros2_control name='GazeboSystem' type='system'>
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      <joint name='left_wheel_joint'>
        <command_interface name='velocity'>
          <param name='min'>-20</param>
          <param name='max'>20</param>
        </command_interface>
        <state_interface name='velocity'/>
        <state_interface name='position'/>
      </joint>
      <joint name='right_wheel_joint'>
        <command_interface name='velocity'>
          <param name='min'>-20</param>
          <param name='max'>20</param>
        </command_interface>
        <state_interface name='velocity'/>
        <state_interface name='position'/>
      </joint>
    </ros2_control>
  </xacro:if>

  <!-- ADD FLAG FOR FORTRESS -->
  <!-- WHAT ABOUT THE LIDAR SENSOR FOR FORTRESS? -->
  <!-- DO WE HAVE TO CREATE A NEW BRANCH INSTEAD -->
  <!-- OR MAYBE HAVE OUR OWN URDF DIRECTORY LIKE ANDINO DID -->

  <gazebo>
    <plugin name='gazebo_ros2_control' filename='libgazebo_ros2_control.so'>
      <parameters>$(find d_hospital_description)/config/controllers.yaml</parameters>
      <parameters>$(find d_hospital_description)/config/gazebo_ros2_ctl_use_sim.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
