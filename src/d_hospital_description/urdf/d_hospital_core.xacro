<?xml version="1.0" ?>
<robot name="d_hospital" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Arquivo gerado a partir dos STLs exportados da montagem SolidWorks.

    Convenção adotada:
      - STLs em milímetros: mesh_scale = 0.001.
      - Eixo X do SolidWorks -> eixo X do ROS.
      - Eixo Y do SolidWorks -> eixo Z do ROS.
      - Eixo Z do SolidWorks -> eixo -Y do ROS.
      - base_link fica no centro longitudinal/lateral do chassi e na altura do eixo das rodas.
      - base_footprint fica no solo, abaixo de base_link.

    Coloque as malhas renomeadas em:
      d_hospital_description/meshes/mhemapcomp_clean/
  -->

  <xacro:property name="mesh_dir" value="package://d_hospital_description/meshes/mhemapcomp_clean"/>
  <xacro:property name="mesh_scale" value="0.001"/>

  <!-- Origem da montagem SolidWorks, em metros, usada para alinhar todas as peças ao base_link. -->
  <xacro:property name="sw_origin_x" value="0.127772"/>
  <xacro:property name="sw_origin_y" value="0.038959"/>
  <xacro:property name="sw_origin_z" value="0.234666"/>
  <xacro:property name="sw_tx" value="-0.127772"/>
  <xacro:property name="sw_ty" value="0.234666"/>
  <xacro:property name="sw_tz" value="-0.038959"/>

  <!-- Propriedades obtidas das dimensões dos STLs. -->
  <xacro:property name="base_length" value="0.25"/>
  <xacro:property name="base_width"  value="0.18"/>
  <xacro:property name="base_height" value="0.0532"/>
  <xacro:property name="base_mass" value="1.20"/>
  <xacro:property name="base_collision_z" value="0.01245"/>

  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.031"/>
  <xacro:property name="wheel_separation" value="0.1648"/>

  <!-- Transforma uma malha exportada em coordenadas globais do SolidWorks para o frame base_link. -->
  <xacro:macro name="solidworks_base_visual" params="visual_name mesh_file">
    <visual name="${visual_name}">
      <origin xyz="${sw_tx} ${sw_ty} ${sw_tz}" rpy="${pi/2} 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/${mesh_file}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
    </visual>
  </xacro:macro>

  <!-- Visual de uma malha cujo link está no centro da própria peça. -->
  <xacro:macro name="solidworks_centered_visual" params="mesh_file ox oy oz">
    <visual>
      <origin xyz="${ox} ${oy} ${oz}" rpy="${pi/2} 0 0"/>
      <geometry>
        <mesh filename="${mesh_dir}/${mesh_file}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
      </geometry>
    </visual>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <xacro:solidworks_base_visual visual_name="chassis_visual" mesh_file="chassis.stl"/>
    <xacro:solidworks_base_visual visual_name="upper_deck_visual" mesh_file="upper_deck.stl"/>
    <xacro:solidworks_base_visual visual_name="rear_panel_visual" mesh_file="rear_panel.stl"/>
    <xacro:solidworks_base_visual visual_name="support_mhm_visual" mesh_file="support_mhm.stl"/>
    <xacro:solidworks_base_visual visual_name="driver_l298n_visual" mesh_file="driver_l298n.stl"/>
    <xacro:solidworks_base_visual visual_name="esp32_visual" mesh_file="esp32.stl"/>
    <xacro:solidworks_base_visual visual_name="jetson_nano_visual" mesh_file="jetson_nano.stl"/>
    <xacro:solidworks_base_visual visual_name="powerbank_visual" mesh_file="powerbank.stl"/>
    <xacro:solidworks_base_visual visual_name="xl4015_regulator_visual" mesh_file="xl4015_regulator.stl"/>
    <xacro:solidworks_base_visual visual_name="left_motor_visual" mesh_file="left_motor.stl"/>
    <xacro:solidworks_base_visual visual_name="right_motor_visual" mesh_file="right_motor.stl"/>
    <xacro:solidworks_base_visual visual_name="left_encoder_coupler_lm393_visual" mesh_file="left_encoder_coupler_lm393.stl"/>
    <xacro:solidworks_base_visual visual_name="right_encoder_coupler_lm393_visual" mesh_file="right_encoder_coupler_lm393.stl"/>
    <xacro:solidworks_base_visual visual_name="left_encoder_reader_visual" mesh_file="left_encoder_reader.stl"/>
    <xacro:solidworks_base_visual visual_name="right_encoder_reader_visual" mesh_file="right_encoder_reader.stl"/>
    <xacro:solidworks_base_visual visual_name="axis_protector_left_visual" mesh_file="axis_protector_left.stl"/>
    <xacro:solidworks_base_visual visual_name="axis_protector_right_visual" mesh_file="axis_protector_right.stl"/>
    <xacro:solidworks_base_visual visual_name="motor_support_01_visual" mesh_file="motor_support_01.stl"/>
    <xacro:solidworks_base_visual visual_name="motor_support_02_visual" mesh_file="motor_support_02.stl"/>
    <xacro:solidworks_base_visual visual_name="motor_support_03_visual" mesh_file="motor_support_03.stl"/>
    <xacro:solidworks_base_visual visual_name="motor_support_04_visual" mesh_file="motor_support_04.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_01_visual" mesh_file="screw_m2_5x6_01.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_02_visual" mesh_file="screw_m2_5x6_02.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_03_visual" mesh_file="screw_m2_5x6_03.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_04_visual" mesh_file="screw_m2_5x6_04.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_05_visual" mesh_file="screw_m2_5x6_05.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_06_visual" mesh_file="screw_m2_5x6_06.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_07_visual" mesh_file="screw_m2_5x6_07.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_08_visual" mesh_file="screw_m2_5x6_08.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_09_visual" mesh_file="screw_m2_5x6_09.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_10_visual" mesh_file="screw_m2_5x6_10.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_11_visual" mesh_file="screw_m2_5x6_11.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_12_visual" mesh_file="screw_m2_5x6_12.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_13_visual" mesh_file="screw_m2_5x6_13.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_14_visual" mesh_file="screw_m2_5x6_14.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_15_visual" mesh_file="screw_m2_5x6_15.stl"/>
    <xacro:solidworks_base_visual visual_name="screw_m2_5x6_16_visual" mesh_file="screw_m2_5x6_16.stl"/>

    <collision name="base_collision">
      <origin xyz="0 0 ${base_collision_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${base_collision_z}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${(base_mass/12.0) * (base_width*base_width + base_height*base_height)}"
        ixy="0"
        ixz="0"
        iyy="${(base_mass/12.0) * (base_length*base_length + base_height*base_height)}"
        iyz="0"
        izz="${(base_mass/12.0) * (base_length*base_length + base_width*base_width)}"/>
    </inertial>
  </link>

  <!-- Roda esquerda: centro obtido diretamente do STL left_wheel.stl. -->
  <link name="left_wheel">
    <xacro:solidworks_centered_visual mesh_file="left_wheel.stl" ox="-0.073522" oy="0.152366" oz="-0.038959"/>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
        ixy="0"
        ixz="0"
        iyy="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
        iyz="0"
        izz="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.05425 0.0823 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <!-- Roda direita: centro obtido diretamente do STL right_wheel.stl. -->
  <link name="right_wheel">
    <xacro:solidworks_centered_visual mesh_file="right_wheel.stl" ox="-0.073522" oy="0.317166" oz="-0.038959"/>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
        ixy="0"
        ixz="0"
        iyy="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
        iyz="0"
        izz="${(wheel_mass/12.0) * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.05425 -0.0825 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <!-- Roda boba: mantida como junta fixa para simplificar a simulação. -->
  <link name="caster_wheel">
    <xacro:solidworks_centered_visual mesh_file="caster_wheel.stl" ox="-0.224406" oy="0.234666" oz="-0.014309"/>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.033"/>
      <inertia ixx="0.00000825" ixy="0" ixz="0" iyy="0.00000825" iyz="0" izz="0.00000825"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.096635 0 -0.02465" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR: link visual separado para permitir TF do sensor. -->
  <link name="rplidar_link">
    <xacro:solidworks_centered_visual mesh_file="rplidar_a1.stl" ox="-0.093628" oy="0.232936" oz="-0.108759"/>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.050" length="0.040"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00012"/>
    </inertial>
  </link>

  <joint name="rplidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rplidar_link"/>
    <origin xyz="-0.034144 0.001731 0.0698" rpy="0 0 0"/>
  </joint>

  <!-- Frame recomendado para o LaserScan. Ajuste o z se a altura real do plano do laser for medida. -->
  <link name="laser_frame"/>
  <joint name="laser_joint" type="fixed">
    <parent link="rplidar_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.020" rpy="0 0 0"/>
  </joint>

  <!-- IMU MPU6050: frame separado para uso com robot_localization/ekf_node. -->
  <link name="imu_link">
    <xacro:solidworks_centered_visual mesh_file="mpu6050.stl" ox="-0.111" oy="0.235782" oz="-0.035587"/>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.016 0.018"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.0000002" ixy="0" ixz="0" iyy="0.0000002" iyz="0" izz="0.0000002"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.016771 -0.001115 -0.003372" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_wheel">
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1 value="1.16"/>
    <mu2 value="1.16"/>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1 value="1.16"/>
    <mu2 value="1.16"/>
  </gazebo>

</robot>
