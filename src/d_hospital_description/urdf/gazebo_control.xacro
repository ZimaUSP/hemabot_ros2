<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <gazebo>
        <plugin name="lidarbot_diff_drive" filename="libgazebo_ros_diff_drive.so">
            <!-- Wheel information -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.1648</wheel_separation>
            <wheel_diameter>0.065</wheel_diameter>
            <!-- Limits (can be adjusted later on)-->
            <max_wheel_torque>20</max_wheel_torque>
            <max_wheel_acceleration>2</max_wheel_acceleration>
            <!-- Output -->
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
        </plugin>

        <!-- Ground truth: pose exata do robo no mundo, sem ruido, direto do motor de fisica.
             Util para comparar com /odom (que tem drift) e calcular erro (ATE/RPE). -->
        <plugin name="p3d_base_controller" filename="libgazebo_ros_p3d.so">
            <ros>
                <namespace>/</namespace>
                <remapping>odom:=ground_truth/state</remapping>
            </ros>
            <body_name>base_footprint</body_name>
            <frame_name>world</frame_name>
            <update_rate>50.0</update_rate>
            <gaussian_noise>0.0</gaussian_noise>
        </plugin>
    </gazebo>
</robot>

