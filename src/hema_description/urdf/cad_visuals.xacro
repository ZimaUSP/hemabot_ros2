<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="visuals_base_link" params="">
    <visual>
      <geometry><mesh filename="package://hema_description/meshes/base_link_abs.stl" scale="1 1 1"/></geometry>
      <material name="hema_abs"/>
    </visual>
    <visual>
      <geometry><mesh filename="package://hema_description/meshes/base_link_aluminium.stl" scale="1 1 1"/></geometry>
      <material name="hema_aluminium"/>
    </visual>
    <visual>
      <geometry><mesh filename="package://hema_description/meshes/base_link_electronics.stl" scale="1 1 1"/></geometry>
      <material name="hema_electronics"/>
    </visual>
    <visual>
      <geometry><mesh filename="package://hema_description/meshes/base_link_pla.stl" scale="1 1 1"/></geometry>
      <material name="hema_pla"/>
    </visual>
    <visual>
      <geometry><mesh filename="package://hema_description/meshes/base_link_steel.stl" scale="1 1 1"/></geometry>
      <material name="hema_steel"/>
    </visual>
  </xacro:macro>
