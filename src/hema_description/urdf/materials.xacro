<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Aparência visual reutilizável. As cores não atribuem densidade nem atrito;
    as propriedades físicas são configuradas nos parâmetros e no Gazebo.
    Instancie hema_materials uma única vez, no nível raiz de robot.
  -->
  <xacro:macro name="hema_materials" params="">
    <material name="hema_aluminium"><color rgba="0.72 0.75 0.78 1.0"/></material>
    <material name="hema_steel"><color rgba="0.40 0.44 0.48 1.0"/></material>
    <material name="hema_abs"><color rgba="0.12 0.15 0.19 1.0"/></material>
    <material name="hema_pla"><color rgba="0.90 0.91 0.88 1.0"/></material>
    <material name="hema_rubber"><color rgba="0.055 0.055 0.065 1.0"/></material>
    <material name="hema_nylon"><color rgba="0.88 0.86 0.74 1.0"/></material>
    <material name="hema_electronics"><color rgba="0.07 0.35 0.18 1.0"/></material>
    <material name="hema_red"><color rgba="0.78 0.10 0.08 1.0"/></material>
  </xacro:macro>
</robot>
